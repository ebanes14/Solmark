rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function ok() { return request.auth != null && exists(/databases/$(db)/documents/users/$(request.auth.uid)) && me().active != false; }
    function has(r) { return ok() && r in me().roles; }
    function adm() { return has('Administrador'); }
    function cfg() { return get(/databases/$(db)/documents/config/main).data; }
    function rp(r, m) { return has(r) && m in cfg().perm.get(r, []); }
    function can(m) { return adm() || rp('Socio', m) || rp('Supervisor', m) || rp('Vendedor', m) || rp('Cliente', m) || rp('Soporte', m); }
    function ops() { return can('cli') || can('ven') || can('age') || can('tic') || can('pag') || can('res'); }
    function noBoss() { return !exists(/databases/$(db)/documents/config/main); }
    function seeAll() { return adm() || has('Socio') || has('Supervisor') || has('Soporte'); }
    function mine(f) { return seeAll() || resource.data[f] == request.auth.uid; }
    function mineNew(f) { return seeAll() || request.resource.data[f] == request.auth.uid; }

    match /users/{u} {
      allow read: if ok();
      allow create: if (request.auth != null && request.auth.uid == u && request.resource.data.roles == ['Administrador'] && noBoss())
                    || adm() || (can('ven') && request.resource.data.roles == ['Vendedor']);
      allow update: if adm()
                    || (request.auth.uid == u && request.resource.data.roles == resource.data.roles && request.resource.data.active == resource.data.active)
                    || (can('ven') && resource.data.roles == ['Vendedor'] && request.resource.data.roles == ['Vendedor']);
      allow delete: if adm() || (can('ven') && resource.data.roles == ['Vendedor']);
    }
    match /config/main {
      allow read: if ok();
      allow create: if request.auth != null && noBoss();
      allow update: if adm();
    }
    match /config/state {
      allow read, write: if ok() || (request.auth != null && noBoss());
    }
    match /clients/{d} {
      allow read: if ops() && mine('sellerId');
      allow create: if (can('cli') || can('ven')) && mineNew('sellerId');
      allow update: if (can('cli') || can('ven')) && (seeAll() || (resource.data.sellerId == request.auth.uid && request.resource.data.sellerId == request.auth.uid && request.resource.data.active == resource.data.active));
      allow delete: if adm();
    }
    match /pay/{d} {
      allow read: if ops() && mine('sellerId');
      allow create: if (can('cli') || can('pag')) && mineNew('sellerId');
      allow update: if seeAll() && (can('cli') || can('pag') || can('ven'));
      allow delete: if adm();
    }
    match /tickets/{d} {
      allow read: if ops() && mine('sellerId');
      allow create: if (can('tic') || can('cli')) && mineNew('sellerId');
      allow update: if (can('tic') || can('cli')) && mine('sellerId');
      allow delete: if adm();
    }
    match /agenda/{d} {
      allow read: if ops() && mine('userId');
      allow create: if (can('age') || can('cli') || can('ven')) && mineNew('userId');
      allow update: if (can('age') || can('cli') || can('ven')) && mine('userId') && mineNew('userId');
      allow delete: if (can('age') || can('cli') || can('ven')) && mine('userId');
    }
    match /log/{d} {
      allow read: if ops() && mine('sellerId');
      allow create: if ops() && mineNew('sellerId');
      allow update, delete: if adm();
    }
    match /reqs/{d} {
      allow read: if ops() && mine('vend');
      allow create: if can('pag') || can('cli');
      allow update: if ok() && (seeAll() || resource.data.vend == request.auth.uid);
      allow delete: if adm();
    }
    match /ledger/{d} {
      allow read: if ok() && (adm() || has('Socio') || request.auth.uid in resource.data.uids);
      allow create: if (request.resource.data.type == 'comision' && (can('cli') || can('pag'))) || adm();
      allow update, delete: if adm();
    }
    match /notifs/{d} {
      allow read: if request.auth != null && resource.data.to == request.auth.uid;
      allow create: if ok();
      allow update, delete: if request.auth != null && resource.data.to == request.auth.uid;
    }
    match /audit/{d} {
      allow read: if adm() || has('Socio') || (has('Supervisor') && resource.data.sup == request.auth.uid);
      allow create: if ok();
      allow update, delete: if false;
    }
    match /apps/{d} { allow read: if ok(); allow write: if can('apl'); }
    match /exp/{d} { allow read, write: if adm() || has('Socio'); }
    match /hist/{d} { allow read, write: if adm() || has('Soporte'); }
    match /keys/{d} { allow read: if adm() || has('Soporte'); allow write: if adm(); }
  }
}
